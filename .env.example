# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets.

# Build Step 2: Telegram alerts (see README.md for how to get these
# from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Build Step 3: Claude API verdicts (get a key at https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Build Step 4: Context layer - news + economic calendar (free account at
# https://financialmodelingprep.com). Sentiment is derived from these same
# headlines, no second key needed. Optional - AI verdicts still work
# without this, they just won't have news/sentiment context.
FMP_API_KEY=

# scripts/backup_system.py (optional): a second folder to also copy each
# backup zip into, e.g. a Dropbox/Google Drive sync folder. Not needed if
# your project already lives inside a synced folder (this one lives under
# OneDrive, so backups/ is already cloud-synced with no config needed).
CLOUD_BACKUP_FOLDER=
